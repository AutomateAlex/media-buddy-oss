# Media Buddy (source-available, noncommercial) — copy to `.env` in the repo root.
# You can also paste keys in the app: Settings → API Keys (stored in your OS keychain,
# takes effect immediately). Values from .env win over the keychain.

# ============================================================ REQUIRED
# One key for every LLM call (script, shot planning, verifier, vision, research).
# OpenRouter routes to 200+ models (Qwen, Claude, GPT, Gemini, ...). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free stock footage + images. https://www.pexels.com/api/
PEXELS_API_KEY=

# ============================================================ RECOMMENDED
# Qwen voice-over (Alibaba Model Studio): 24 Mandarin voices, the default narrator.
# Without it, voice-over falls back to the free Microsoft Edge voices.
MEDIA_BUDDY_QWEN_API_KEY=
# More free stock sources (each auto-disables when empty).
PIXABAY_API_KEY=
COVERR_API_KEY=

# ============================================================ OPTIONAL
# Premium English voice-over. Also set MEDIA_BUDDY_ENABLE_ELEVENLABS=1.
MEDIA_BUDDY_ELEVENLABS_API_KEY=
MEDIA_BUDDY_ENABLE_ELEVENLABS=0
# Extra background-music source (Pixabay Music needs no key).
FREESOUND_API_KEY=

# ============================================================ MODEL OVERRIDES (all OpenRouter model ids)
# MEDIA_BUDDY_DEFAULT_MODEL=anthropic/claude-haiku-4-5
# OMNI_MODEL=google/gemini-2.5-flash
# Per-purpose: MEDIA_BUDDY_<PURPOSE>_MODEL (see src/backend/lib/llm_client.py)

# ============================================================ RUNTIME
# SQLite DB, downloaded clips and rendered videos live here.
MEDIA_BUDDY_DATA_DIR=~/.media-buddy-oss
